{
  "name": "harmoniq",
  "version": "2.0.1",
  "description": "HARMONIQ - Premium High-Fidelity Audio Player for Windows",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "start": "npm run build && npm run build:electron && electron .",
    "electron": "npm run build:electron && electron .",
    "dist": "npm run build && npm run build:electron && electron-builder --win",
    "test": "vitest run",
    "mobile:build": "vite build && npx cap sync android",
    "mobile:sync": "npx cap sync android",
    "mobile:open": "npx cap open android"
  },
  "build": {
    "appId": "com.harmoniq.player",
    "productName": "Harmoniq",
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "shortcutName": "Harmoniq"
    },
    "fileAssociations": [
      {
        "ext": "flac",
        "name": "FLAC Audio",
        "description": "Free Lossless Audio Codec",
        "role": "Viewer",
        "icon": "assets/icon.ico"
      },
      {
        "ext": "mp3",
        "name": "MP3 Audio",
        "description": "MPEG-1/2 Audio Layer III",
        "role": "Viewer",
        "icon": "assets/icon.ico"
      },
      {
        "ext": "wav",
        "name": "WAV Audio",
        "description": "Waveform Audio File Format",
        "role": "Viewer",
        "icon": "assets/icon.ico"
      },
      {
        "ext": "m4a",
        "name": "M4A Audio",
        "description": "MPEG-4 Audio",
        "role": "Viewer",
        "icon": "assets/icon.ico"
      },
      {
        "ext": "alac",
        "name": "ALAC Audio",
        "description": "Apple Lossless Audio Codec",
        "role": "Viewer",
        "icon": "assets/icon.ico"
      },
      {
        "ext": "ogg",
        "name": "OGG Audio",
        "description": "Ogg Vorbis Audio",
        "role": "Viewer",
        "icon": "assets/icon.ico"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ]
  },
  "keywords": [
    "audio-player",
    "hi-res",
    "flac",
    "dsp",
    "equalizer",
    "wasapi",
    "windows"
  ],
  "author": "Harmoniq Audio Systems",
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/preferences": "^8.0.1",
    "chokidar": "^6.0.0",
    "colorthief": "^3.5.0",
    "flac-tagger": "^2.1.0",
    "lucide-react": "^1.16.0",
    "music-metadata": "^11.16.1",
    "node-id3": "^0.2.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.2",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "minimatch": "^11.0.9"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true
  }
}
